<Application
    x:Class="MicroBoostGameBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicroBoostGameBar"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>

            <Color
                x:Key="SystemAccentColor">
                #26C58C
            </Color>

            <SolidColorBrush
                x:Key="SystemControlForegroundAccentBrush"
                Color="#26C58C"/>

            <SolidColorBrush
                x:Key="SystemControlHighlightAccentBrush"
                Color="#26C58C"/>

        </ResourceDictionary>
    </Application.Resources>

</Application>
